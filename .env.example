# ==============================================================================
# Brightloop Subscription Management System - Environment Configuration (.env)
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=brightloop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/brightloop

# Redis Cache & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=180

# Security & Authentication (Argon2id + JWT Tokens [PDF 9])
JWT_SECRET=brightloop-secret-key-odoo-hackathon-2026-very-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# CORS Origins (Allows Vite dev server port 5173 and Next/React port 3000)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Application Business Defaults [PDF 5]
DEFAULT_CURRENCY=INR
INVOICE_PREFIX=INV-2026-
SUBSCRIPTION_PREFIX=SUB-2026-
DEBUG=False

